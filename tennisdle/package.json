{
  "name": "tennisdle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "tennisdle.pivi.dev",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "cd .. & husky",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "predeploygh": "pnpm run build",
    "deploygh": "gh-pages -d dist",
    "update:packages": "ncu --upgrade --reject @eslint/js,eslint"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "autoprefixer": "^10.5.0",
    "floating-vue": "^5.2.2",
    "fuse.js": "^7.3.0",
    "redux-persist": "^6.0.0",
    "vue": "^3.5.35",
    "vue-confetti-explosion": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-vue": "^10.9.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.6",
    "prettier": "3.8.3",
    "sass": "^1.100.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vite-plugin-qrcode": "^0.4.1",
    "vite-svg-loader": "^5.1.1",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.1.0",
    "vue-tsc": "^3.3.3"
  },
  "lint-staged": {
    "src/**/*.{js,vue,html,css}": "prettier --write",
    "src/**/*.{js,vue}": "eslint --fix"
  }
}
